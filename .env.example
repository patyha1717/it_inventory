APP_NAME="IT Inventory"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itms_prod
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=smtp-key
MAIL_PASSWORD=smtp-secret-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=itinventory@arukustech.com
MAIL_FROM_NAME="Arukus Inventory"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-us.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=us2

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://localhost

# Application Configuration
COMPANY_NAME="Arukus Technologies"
COMPANY_LOGO="/assets/logo/mail_logo.png"
MAIL_CC=tkarmakar@arukustech.com,jfaruque@arukustech.in
